# Copy to .env.local and fill in. .env*.local is gitignored — never commit it.
# Where each value comes from: docs/RUNBOOK.md
#
# ⚠️ Pasting into Vercel: paste the VALUE ONLY. Not `NAME=value`, no quotes.
# A quoted or scheme-less NEXT_PUBLIC_SUPABASE_URL is what 500'd production on
# 2026-08-05 — docs/LEARNINGS.md. And NEXT_PUBLIC_* is baked in at build time, so
# every env change needs a REDEPLOY before it takes effect.

# --- Supabase (Phase 2/3) ---
# New-style keys (sb_publishable_… / sb_secret_…). The legacy anon/service_role
# JWT keys are deprecated at the end of 2026 — see docs/DECISIONS.md B9.
# The URL is "Project URL" under Supabase → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_

# Server only. Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
SUPABASE_SECRET_KEY=sb_secret_

# Migrations and scripts only, never the app — so it does NOT go in Vercel.
# Session pooler (5432), NOT the transaction pooler (6543), which cannot run all
# our DDL. Percent-encode any / & @ : ? in the password or the URI parses wrong.
SUPABASE_DB_URL=

# --- Payments (Phase 7) — docs/RUNBOOK.md ---
# coming_soon | manual_upi | razorpay_test | razorpay_live.
# Anything else — and both razorpay_* , which are unbuilt — fails closed to
# coming_soon.
NEXT_PUBLIC_PAYMENTS_MODE=coming_soon

# The single switch that turns payments on: manual_upi with an empty VPA stays
# coming_soon. Phase 1 ships a PERSONAL handle knowingly — DECISIONS D6 — which
# means payers see the operator's legal name, because UPI apps show the name the
# bank has against the VPA and ignore the payee name we send. Swap to the PhonePe
# Business VPA (docs/RUNBOOK.md) and delete the notice on /pay/[ref].
NEXT_PUBLIC_UPI_VPA=
NEXT_PUBLIC_UPI_PAYEE_NAME=MaxPoll

# Comma-separated profile UUIDs allowed into /admin.
# Empty = nobody, and /admin returns 404 to everyone.
ADMIN_USER_IDS=

# Razorpay. The key id is public — Razorpay’s checkout script takes it as an
# option — and the secret never leaves the server. paymentMode() checks the id’s
# rzp_test_/rzp_live_ prefix against NEXT_PUBLIC_PAYMENTS_MODE and fails closed on
# a mismatch, so test keys can never run under razorpay_live.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A DIFFERENT value from the key secret — you choose it in Razorpay → Settings →
# Webhooks, on a hook pointing at /api/razorpay/webhook for payment.captured.
# Unset means the webhook rejects everything, which loses the net for a payer who
# closes the tab mid-payment.
RAZORPAY_WEBHOOK_SECRET=

# --- App ---
# Local: http://localhost:3000. In Vercel: https://maxpoll.vercel.app —
# a localhost value here would send every production sign-in to your laptop.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel sends `Authorization: Bearer $CRON_SECRET` to cron routes (Phase 5).
CRON_SECRET=
