# Copy to .env.local and fill in. .env*.local is gitignored — never commit it.
# Setup steps for each value: docs/02-SETUP.md

# --- Supabase (Phase 2/3) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Phase 7) ---
# test | coming_soon | live. Missing or unrecognised => coming_soon (fail closed).
NEXT_PUBLIC_PAYMENTS_MODE=coming_soon
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel sends `Authorization: Bearer $CRON_SECRET` to cron routes (Phase 5).
CRON_SECRET=
