# Copy to .env.local and fill in. .env*.local is gitignored — never commit it.
# Where each value comes from: docs/07-setup.md

# --- Supabase (Phase 2/3) ---
# New-style keys (sb_publishable_… / sb_secret_…). The legacy anon/service_role
# JWT keys are deprecated at the end of 2026 — see docs/DECISIONS.md B9.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_

# Server only. Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
SUPABASE_SECRET_KEY=sb_secret_

# --- Payments (Phase 7) ---
# test | coming_soon | live. Missing or unrecognised => coming_soon (fail closed).
NEXT_PUBLIC_PAYMENTS_MODE=coming_soon
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Different value from the key secret. Set in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel sends `Authorization: Bearer $CRON_SECRET` to cron routes (Phase 5).
CRON_SECRET=
